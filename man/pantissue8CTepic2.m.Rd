\name{pantissue8CTepic2.m}
\alias{pantissue8CTepic2.m}
\docType{data}
\title{Pan-tissue DNA methylation reference for eight cell types on EPIC v2}
\description{
A reference matrix for estimating cell-type fractions with \code{\link{epidish}}.
This reference uses EPIC v2 probe identifiers with suffixes.
Match the row names of the sample matrix to the identifiers used in this reference.
}
\usage{data(pantissue8CTepic2.m)}
\format{
An 800 by 8 numeric matrix of DNA methylation beta values. The columns
are Epithelial, Endothelial, Fibroblast, Adipocyte, B, non-B lymphoid,
MonoMac and Granulocyte.
}
\seealso{\code{\link{pantissue8CT.m}}, \code{\link{pantissue8CTmsa.m}}}
\keyword{datasets}
